{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/openclaw/**/*.ts"],
  "exclude": ["src/openclaw/**/*.test.ts", "src/openclaw/test-fixtures.ts"]
}
